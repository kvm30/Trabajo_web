PORT=3000

# PostgreSQL
# Opcional: URL completa de una base externa con TLS (por ejemplo, Neon).
DATABASE_URL=
# Si DATABASE_URL está vacía, se usan estos campos locales:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backweb_db
DB_USER=postgres
DB_PASSWORD=

# Auth
JWT_SECRET=cambia_esto_por_un_secreto_largo
# Admin que se crea automáticamente al arrancar
ADMIN_EMAIL=admin@votacion.com
ADMIN_PASSWORD=admin123
