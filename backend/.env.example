# URL del frontend visible para links correos y reset de contraseña.
# Si se comparte desde la red local, usa la IP del equipo (por ejemplo http://192.168.1.25:5173), no localhost.
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
